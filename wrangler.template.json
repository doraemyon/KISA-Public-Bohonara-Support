{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kisa-public-bohonara-support",
  "main": "../src/index.ts",
  "compatibility_date": "2026-11-07",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BOT_USERNAME": "__BOT_USERNAME__",
    "KISA_RSS_URL": "https://www.boho.or.kr/kr/rss.do?bbsId=B0000133",
    "NOTICE_PAGES_BASE_URL": "__NOTICE_PAGES_BASE_URL__",
    "MAX_SUBSCRIBERS": "__MAX_SUBSCRIBERS__",
    "BROADCAST_BATCH_SIZE": "__BROADCAST_BATCH_SIZE__"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "../migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

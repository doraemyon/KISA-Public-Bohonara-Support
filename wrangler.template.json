{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "notice",
  "workers_dev": true,
  "main": "../src/index.ts",
  "assets": {
    "directory": "../public"
  },
  "compatibility_date": "2026-11-10",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BOT_USERNAME": "__BOT_USERNAME__",
    "KISA_RSS_URL": "https://www.boho.or.kr/kr/rss.do?bbsId=B0000133",
    "PUBLIC_BASE_URL": "__PUBLIC_BASE_URL__",
    "MAX_SUBSCRIBERS": "__MAX_SUBSCRIBERS__",
    "BROADCAST_BATCH_SIZE": "__BROADCAST_BATCH_SIZE__",
    "MAX_PENDING_APPLICATIONS": "__MAX_PENDING_APPLICATIONS__",
    "MAX_APPLICATIONS_PER_HOUR": "__MAX_APPLICATIONS_PER_HOUR__",
    "ADMIN_NOTIFICATION_BATCH_SIZE": "__ADMIN_NOTIFICATION_BATCH_SIZE__"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "../migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
